---
import { getPersons } from "@lib/content";
import PersonCard from "@components/PersonCard.astro";

interface Props {
    ids?: string[];
    limit?: number;
}

const { ids, limit } = Astro.props;

let persons = await getPersons(ids);
if (limit) persons = persons.slice(0, limit);
---

{persons.length > 0 && (
    <>
        <slot />
        <ul class="not-prose flex flex-col gap-10 my-8">
            {persons.map((person) => (
                <li><PersonCard person={person} /></li>
            ))}
        </ul>
    </>
)}
