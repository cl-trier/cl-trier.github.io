---
import { getCollection } from "astro:content";
import PersonCard from "@components/PersonCard.astro";

interface Props {
    ids?: string[];
    limit?: number;
}

const { ids, limit } = Astro.props;

let persons = await getCollection("persons");
persons = ids
    ? ids.flatMap((id) => persons.filter((p) => p.id === id))
    : persons.sort((a, b) => a.data.name.localeCompare(b.data.name));
if (limit) persons = persons.slice(0, limit);
---

<ul class="not-prose flex flex-col gap-10 my-8">
    {persons.map((person) => (
        <li><PersonCard person={person} /></li>
    ))}
</ul>
