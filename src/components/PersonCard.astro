---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Image } from "astro:assets";
import { personHref } from "@lib/content";

interface Props {
    person: CollectionEntry<"persons">;
}

const { person } = Astro.props;
const { name, position, image, links } = person.data;
const { Content } = await render(person);
---

<article id={`person-${person.id}`} class="not-prose flex flex-col gap-4 sm:flex-row">
    {image && (
        <Image
            src={image}
            alt={`Portrait of ${name}`}
            width={128}
            height={128}
            class="size-32 shrink-0 rounded-full object-cover bg-slate-100"
        />
    )}
    <div class="flex flex-col gap-2">
        <header>
            <h3 class="text-lg font-bold">
                <a class="hover:underline underline-offset-4" href={personHref(person.id)}>{name}</a>
            </h3>
            <p class="text-sm text-slate-500">{position}</p>
        </header>
        <div class="prose prose-sm">
            <Content />
        </div>
        {links.length > 0 && (
            <ul class="flex flex-wrap gap-4 text-sm">
                {links.map((link) => (
                    <li>
                        <a class="underline underline-offset-4 hover:text-slate-500" href={link.url}>
                            {link.label}
                        </a>
                    </li>
                ))}
            </ul>
        )}
    </div>
</article>
