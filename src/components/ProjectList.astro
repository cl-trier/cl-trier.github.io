---
import { getProjects } from "@lib/content";
import ProjectCard from "@components/ProjectCard.astro";

interface Props {
    person?: string;
    limit?: number;
}

const { person, limit } = Astro.props;

let projects = await getProjects(person);
if (limit) projects = projects.slice(0, limit);
---

{projects.length > 0 && (
    <>
        <slot />
        <ul class="not-prose flex flex-col gap-10 my-8">
            {projects.map((project) => (
                <li><ProjectCard project={project} /></li>
            ))}
        </ul>
    </>
)}
