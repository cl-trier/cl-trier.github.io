---
import type { CollectionEntry } from "astro:content";
import { getCollection, getEntry, render } from "astro:content";
import { personHref, projectHref } from "@lib/content";

interface Props {
    publication: CollectionEntry<"publications">;
}

const { publication } = Astro.props;
const { title, authors, venue, year, link, project } = publication.data;
const { Content } = await render(publication);
const allPersons = await getCollection("persons");
// authors with a profile are linked; others are shown as given (slugs like "jane-doe" become "Jane Doe")
const prettify = (s: string) =>
    /\s/.test(s) ? s : s.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
const persons = authors.map((author) => {
    const person = allPersons.find((p) => p.id === author);
    return person
        ? { name: person.data.name, href: personHref(person.id) }
        : { name: prettify(author), href: undefined };
});
const projectEntry = project ? await getEntry(project) : undefined;
---

<article id={`publication-${publication.id}`} class="not-prose flex flex-col gap-1">
    <h3 class="font-bold">
        {link ? <a class="underline underline-offset-4" href={link}>{title}</a> : title}
    </h3>
    <p class="text-sm">
        {persons.map((person, i) => (
            <>
                {person.href
                    ? <a class="hover:underline underline-offset-4" href={person.href}>{person.name}</a>
                    : person.name}{i < persons.length - 1 && ", "}
            </>
        ))}
    </p>
    <p class="text-sm italic text-slate-500">{venue}, {year}</p>
    {projectEntry && (
        <p class="text-sm text-slate-500">
            Project: <a class="underline underline-offset-4" href={projectHref(projectEntry.id)}>{projectEntry.data.shortTitle}</a>
        </p>
    )}
    <details class="text-sm">
        <summary class="cursor-pointer text-slate-500 hover:underline underline-offset-4">Abstract</summary>
        <div class="prose prose-sm mt-2">
            <Content />
        </div>
    </details>
</article>
