---
import { getPublications } from "@lib/content";
import PublicationCard from "@components/PublicationCard.astro";

interface Props {
    author?: string;
    project?: string;
    limit?: number;
}

const { author, project, limit } = Astro.props;

let publications = await getPublications(author, project);
if (limit) publications = publications.slice(0, limit);
---

{publications.length > 0 && (
    <>
        <slot />
        <ul class="not-prose flex flex-col gap-6 my-8">
            {publications.map((publication) => (
                <li><PublicationCard publication={publication} /></li>
            ))}
        </ul>
    </>
)}
