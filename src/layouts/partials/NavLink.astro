---
import { currentPath } from "@lib/menu";

interface Props {
    href: string;
    class?: string;
}

const { href, class: className } = Astro.props;
const active = currentPath(Astro.url) === href;
---

<a
    class:list={[className, "hover:underline underline-offset-4", { "font-bold underline": active }]}
    href={href}
>
    <slot />
</a>
