---
import CONFIG from "@content/site/config.json";
import NavMenu from "@layouts/partials/NavMenu.astro";
import { currentPath, findSection, getMenuItems } from "@lib/menu";

const menuItems = await getMenuItems();
const section = findSection(menuItems, currentPath(Astro.url));

// menu groups, separated by a divider: in a section only its sub pages, otherwise main and separated items
const groups = section
    ? [section.children]
    : [menuItems.filter((item) => !item.separated), menuItems.filter((item) => item.separated)];
const menus = groups.filter((group) => group.length > 0);
---

<nav class="container relative mx-auto px-4 my-6">
    <div class="flex gap-12 items-center justify-between">
        {section ? (
            <div class="flex shrink-0 flex-col">
                <a class="text-lg font-bold" href={section.href}>{section.label}</a>
                <a class="text-xs text-slate-500 hover:underline underline-offset-4" href="/">← {CONFIG.shortName}</a>
            </div>
        ) : (
            <a class="text-lg font-bold" href="/">{CONFIG.name}</a>
        )}

        <!-- desktop: in a row, horizontally scrollable within a section -->
        <div class:list={["hidden md:flex min-w-0 items-center gap-8", { "overflow-x-auto": section }]}>
            {menus.map((items, i) => (
                <>
                    {i > 0 && <span class="text-slate-300" aria-hidden="true">|</span>}
                    <NavMenu items={items} />
                </>
            ))}
        </div>

        <!-- mobile: toggled panel below the navbar -->
        <details class="md:hidden">
            <summary class="cursor-pointer list-none hover:underline underline-offset-4 [&::-webkit-details-marker]:hidden">Menu</summary>
            <div class="absolute inset-x-0 top-full z-20 mt-2 flex flex-col gap-4 bg-slate-100 p-4">
                {menus.map((items, i) => (
                    <>
                        {i > 0 && <hr class="border-slate-300" />}
                        <NavMenu items={items} vertical />
                    </>
                ))}
            </div>
        </details>
    </div>
</nav>
