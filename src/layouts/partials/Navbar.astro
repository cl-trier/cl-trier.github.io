---
import { getCollection } from "astro:content";

import CONFIG from "@content/site/config.json";

interface MenuItem {
    label: string;
    href: string;
    children: MenuItem[];
}

function getHref(id: string): string {
    return id === "index" ? "/" : `/${id}/`;
}

async function getMenuItems(): Promise<MenuItem[]> {
    const pages = await getCollection("pages");
    const menuItems = new Map<string, MenuItem>();
    const topLevelItems: MenuItem[] = [];

    for (const page of pages) {
        menuItems.set(page.id, {
            label: page.data.menuLabel,
            href: getHref(page.id),
            children: [],
        });
    }

    for (const page of pages) {
        const item = menuItems.get(page.id);
        const parentId = page.id.includes("/")
            ? page.id.slice(0, page.id.lastIndexOf("/"))
            : undefined;
        const parent = parentId ? menuItems.get(parentId) : undefined;

        if (!item || !parent) {
            if (item) topLevelItems.push(item);
            continue;
        }

        parent.children.push(item);
    }

    return topLevelItems;
}

const menuItems = await getMenuItems();
---

<nav class="container mx-auto px-4 my-6">
    <div class="flex gap-12 items-center justify-between">
        <span class="text-lg font-bold">
            {CONFIG.name}
        </span>
        <div class="relative">
            <ul class="flex flex-wrap gap-8">
                {menuItems.map((item) => 
                    <li class="relative group">
                        <a
                            class="hover:underline underline-offset-4"
                            href={item.href}
                        >
                            {item.label}
                        </a>
                        {item.children.length > 0 && (
                            <ul class="absolute left-0 top-full z-10 hidden min-w-max flex-col gap-2 bg-white py-2 pr-4 group-hover:flex group-focus-within:flex">
                                {item.children.map((child) => (
                                    <li>
                                        <a
                                            class="block px-2 hover:underline underline-offset-4"
                                            href={child.href}
                                        >
                                            {child.label}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        )}
                    </li>
                )}
            </ul>
        </div>
    </div>
</nav>